# Replace the ALSA-ID markers with observed, persistent host card IDs.
context.objects = [
    { factory = adapter
      args = {
        factory.name = api.alsa.pcm.sink
        node.name = ca7_card_a
        node.description = "CA7 card A eight-channel output"
        media.class = "Audio/Sink"
        api.alsa.path = "hw:@CARD_A_ALSA_ID@,0"
        clock.name = "api.alsa.sendspin_card_a"
        audio.format = "S16LE"
        audio.rate = 48000
        audio.allowed-rates = [ 48000 ]
        audio.channels = 8
        audio.position = [ FL FR FC LFE RL RR SL SR ]
        api.alsa.use-chmap = true
        channelmix.disable = true
        node.suspend-on-idle = true
        session.suspend-timeout-seconds = 15
        adapter.auto-port-config = {
            mode = dsp
            monitor = false
            control = false
            position = preserve
        }
      }
      flags = [ nofail ]
    }
    { factory = adapter
      args = {
        factory.name = api.alsa.pcm.sink
        node.name = ca7_card_b
        node.description = "CA7 card B eight-channel output"
        media.class = "Audio/Sink"
        api.alsa.path = "hw:@CARD_B_ALSA_ID@,0"
        clock.name = "api.alsa.sendspin_card_b"
        audio.format = "S16LE"
        audio.rate = 48000
        audio.allowed-rates = [ 48000 ]
        audio.channels = 8
        audio.position = [ FL FR FC LFE RL RR SL SR ]
        api.alsa.use-chmap = true
        channelmix.disable = true
        node.suspend-on-idle = true
        session.suspend-timeout-seconds = 15
        adapter.auto-port-config = {
            mode = dsp
            monitor = false
            control = false
            position = preserve
        }
      }
      flags = [ nofail ]
    }
]
